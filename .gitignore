# ---------------------------------------------------------------- Rust / Cargo
# Shared build cache (<repo>/target via .cargo/config.toml) and any per-crate target dirs.
# NOTE: not a bare `debug` pattern (GitHub's Rust template) — that would hide src/debug/ (the debug tab).
/debug/
target/
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# ---------------------------------------------------------------- Tauri
# Generated capability schemas (each snapshot's src-tauri/.gitignore also covers this).
**/src-tauri/gen/schemas/
# Per-snapshot built executables (tools/build-exe.mjs) and any stray binaries/installers.
snapshots/*/exe/
*.exe
*.msi
*.msix
*.appx

# ---------------------------------------------------------------- Node / Vite (React + TypeScript)
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
*.local
coverage/
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---------------------------------------------------------------- Secrets and local settings
.env
.env.*
!.env.example
.claude/settings.local.json

# ---------------------------------------------------------------- Editors and OS
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------- Test leftovers
# Synthetic works made while testing must never be committed (real ones live outside the repo).
**/.galpi/
galpi-*-test/
